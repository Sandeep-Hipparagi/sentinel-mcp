{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.Sandeep-Hipparagi/sentinel-mcp",
  "title": "Sentinel MCP",
  "description": "Deterministic claim verification, fail-closed policy gate, WORM audit ledger, and graph memory.",
  "version": "0.1.1",
  "publisher": {
    "name": "Sandeep Hipparagi",
    "url": "https://bluepatterns.ai/"
  },
  "repository": {
    "source": "github",
    "url": "https://github.com/Sandeep-Hipparagi/sentinel-mcp"
  },
  "packages": [
    {
      "registryType": "pypi",
      "identifier": "sentinel-mcp-guard",
      "version": "0.1.1",
      "transport": {
        "type": "stdio",
        "command": "sentinel-mcp",
        "args": ["serve", "--transport", "stdio"]
      }
    }
  ],
  "tools": [
    "verify_claim",
    "policy_check",
    "audit_append",
    "audit_verify",
    "memory_upsert",
    "memory_add_edge",
    "memory_query"
  ],
  "license": "MIT"
}
